.DS_Store

# Ignore tmux plugin manager (tpm) plugins
/.config/tmux/plugins/


# Docker cagent (docker agent plugin) first-run marker + telemetry UUID
/.config/cagent/

# herdr writes its sockets, logs and session state next to its config — track only the config
/.config/herdr/*
!/.config/herdr/config.toml

# herdr-app (desktop app) keeps its bundled mods, icons, layouts, window state, telemetry and socket
# next to its config — track only settings, keys and the catppuccin theme
/.config/herdr-app/*
!/.config/herdr-app/settings.json
!/.config/herdr-app/keys.json
!/.config/herdr-app/themes/
/.config/herdr-app/themes/*
!/.config/herdr-app/themes/catppuccin.json

# yolobox holds secrets (claude-token, azure-sp.env) alongside its config; never commit
/.config/yolobox/

# Context7 CLI (ctx7) login writes its OAuth credentials here via the ~/.config symlink; never commit
/.config/context7/

# ai-memory per-machine config and restic passwords (restic repo paths, project list, *.pw); never commit
/.config/ai-memory/

# gh CLI: hosts.yml is per-machine auth state, config.yml is untouched defaults; never commit
/.config/gh/
