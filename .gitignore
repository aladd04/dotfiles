.DS_Store

# Ignore tmux plugin manager (tpm) plugins
/.config/tmux/plugins/


# Docker cagent (docker agent plugin) first-run marker + telemetry UUID
/.config/cagent/

# herdr writes its sockets, logs and session state next to its config — track only the config
/.config/herdr/*
!/.config/herdr/config.toml

# ai-memory per-machine config and restic passwords (restic repo paths, project list, *.pw); never commit
/.config/ai-memory/
